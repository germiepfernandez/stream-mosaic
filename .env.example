# Optional — required only for Connect Twitch / Connect YouTube and live badges.
# Watching pasted links works with no keys.

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Twitch developer app: https://dev.twitch.tv/console/apps
# Redirect URL: http://127.0.0.1:43123/api/auth/callback/twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Google Cloud OAuth client (YouTube Data API enabled)
# Redirect URL: http://127.0.0.1:43123/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API key (for live status refresh; free daily quota)
YOUTUBE_API_KEY=

# Public URL of this app (used by Auth.js in production)
# AUTH_URL=http://127.0.0.1:43123
